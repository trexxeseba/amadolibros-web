{
  "permissions": {
    "allow": [
      "mcp__Windsor_ai__get_data",
      "mcp__Windsor_ai__get_fields",
      "mcp__Windsor_ai__get_connectors",
      "mcp__Windsor_ai__list_actions",
      "mcp__Windsor_ai__get_options"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-amado-libros.mjs\"",
            "timeout": 10,
            "statusMessage": "Revisando si toca Amado Libros"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secretos.mjs\"",
            "timeout": 10,
            "statusMessage": "Revisando si toca credenciales"
          }
        ]
      }
    ]
  }
}
