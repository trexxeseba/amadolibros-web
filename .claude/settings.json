{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-amado-libros.mjs\"",
            "timeout": 10,
            "statusMessage": "Revisando si toca Amado Libros"
          }
        ]
      }
    ]
  }
}
