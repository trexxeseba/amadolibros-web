---
import CartIcon from './CartIcon.astro';
import AnnouncementBar from './AnnouncementBar.astro';

interface Props {
  showSearch?: boolean;
}

const {
  showSearch = true,
} = Astro.props;
---
<header class="site-header">
  <AnnouncementBar />
  <div class:list={['header-inner', { 'without-search': !showSearch }]}>

    <a href="/" class="brand" aria-label="Amado Libros — inicio">
      <img
        src="/images/logo-amado.webp"
        alt="Amado Libros"
        width="58"
        height="57"
        class="brand-logo"
      />
      <span class="brand-copy" aria-hidden="true">
        <strong>AMADO LIBROS</strong>
        <small>Librería en línea</small>
      </span>
    </a>

    <nav class="header-nav" aria-label="Navegación principal">
      <a href="/catalogo">Catálogo</a>
      <a href="/pedir-libro/?tipo=exacto">Pedir un libro</a>
    </nav>

    {showSearch && (
      <button
        type="button"
        class="search-pill"
        onclick="document.dispatchEvent(new CustomEvent('amado:openCatalogSearch'))"
        aria-label="Buscar en el catálogo"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="m11 11 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span class="search-pill-label">Buscar</span>
      </button>
    )}

    <CartIcon />

  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(250, 246, 239, 0.97);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
    margin-right: auto;
    transition: opacity 0.15s;
  }
  .brand:hover { opacity: 0.78; }

  .brand-logo {
    display: block;
    width: auto;
    height: 40px;
    flex-shrink: 0;
  }

  .brand-copy {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 0.05rem;
    color: var(--ink);
    line-height: 1;
  }

  .brand-copy strong {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.085em;
  }

  .brand-copy small {
    color: var(--ink-2);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.025em;
  }

  .header-nav {
    display: none;
    align-items: center;
    gap: 0.2rem;
    margin-right: 0.35rem;
  }

  .header-nav a {
    padding: 0.55rem 0.65rem;
    border-radius: 0.4rem;
    color: var(--ink-2);
    font-size: 0.73rem;
    font-weight: 700;
    line-height: 1;
  }

  .header-nav a:hover {
    background: rgba(31, 27, 24, 0.05);
    color: var(--ink);
  }

  .search-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 40px;
    padding: 0.4rem 0.75rem;
    background: var(--surface);
    border: 1px solid #d8d0c5;
    border-radius: 999px;
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .search-pill:hover {
    background: #fff;
    border-color: #bfb4a7;
    color: var(--ink);
  }

  .search-pill-label { display: none; }

  .site-header :global(.cart-icon-btn) {
    min-width: 40px;
    min-height: 40px;
    color: var(--ink-2);
    border-color: #d8d0c5;
    background: var(--surface);
  }

  .site-header :global(.cart-icon-btn:hover) {
    background: #fff;
    border-color: #bfb4a7;
    color: var(--ink);
  }

  @media (min-width: 520px) {
    .brand-copy { display: flex; }
  }

  @media (min-width: 700px) {
    .search-pill-label { display: inline; }
  }

  @media (min-width: 820px) {
    .header-nav { display: flex; }
  }

  @media (min-width: 1100px) {
    .header-inner {
      padding: 0 2rem;
    }

    .brand-logo {
      height: 42px;
    }
  }
</style>
