---
import CartIcon from './CartIcon.astro';
import AnnouncementBar from './AnnouncementBar.astro';

interface Props {
  showSearch?: boolean;
}

const {
  showSearch = true,
} = Astro.props;

const homeMode = !showSearch;

const subjects = [
  { label: 'Literatura', href: '/libros/literatura-ficcion' },
  { label: 'Psicología', href: '/libros/psicologia' },
  { label: 'Medicina', href: '/libros/medicina-salud' },
  { label: 'Infantiles', href: '/libros/infantil-juvenil' },
  { label: 'Tarot y oráculos', href: '/libros/esoterismo-tarot' },
  { label: 'Biblias', href: '/libros/biblias' },
  { label: 'Idiomas', href: '/libros/idiomas-aprendizaje' },
  { label: 'Ver todos', href: '/catalogo' },
];
---
<header class:list={['site-header', { 'site-header-home': homeMode }] }>
  <AnnouncementBar editorial={homeMode} />

  {homeMode ? (
    <>
      <div class="editorial-header-inner">
        <a href="/" class="editorial-brand" aria-label="Amado Libros — inicio">
          <img
            src="/images/logo-amado.webp"
            alt=""
            width="58"
            height="57"
            class="editorial-logo"
          />
          <span class="editorial-brand-copy">
            <strong>AMADO LIBROS</strong>
            <small>Librería en línea</small>
          </span>
        </a>

        <nav class="editorial-nav" aria-label="Navegación principal">
          <a href="#incorporaciones-recientes">Libros</a>
          <a href="#temas">Temas</a>
          <a href="#incorporaciones-recientes">Recomendados</a>
          <a href="#amado-lee">Ideas</a>
          <a class="editorial-nav-emphasis" href="/pedir-libro/?tipo=exacto">Pedir un libro</a>
          <a href="/quienes-somos">Nosotros</a>
        </nav>

        <div class="editorial-actions">
          <button
            type="button"
            class="editorial-search"
            onclick="document.dispatchEvent(new CustomEvent('amado:openCatalogSearch'))"
            aria-label="Buscar en el catálogo"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.8"/>
              <path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>

          <CartIcon />

          <details class="editorial-menu">
            <summary aria-label="Abrir menú">
              <span></span><span></span><span></span>
            </summary>
            <div class="editorial-menu-panel">
              <a href="#incorporaciones-recientes">Libros</a>
              <a href="#temas">Temas</a>
              <a href="#amado-lee">Ideas</a>
              <a href="/pedir-libro/?tipo=exacto">Pedir un libro</a>
              <a href="/quienes-somos">Nosotros</a>
            </div>
          </details>
        </div>
      </div>

      <nav class="subject-strip" aria-label="Temas destacados">
        <div class="subject-strip-inner">
          {subjects.map(subject => <a href={subject.href}>{subject.label}</a>)}
        </div>
      </nav>
    </>
  ) : (
    <div class="header-inner">
      <a href="/" class="brand" aria-label="Amado Libros — inicio">
        <img
          src="/images/logo-amado.webp"
          alt="Amado Libros"
          width="58"
          height="57"
          class="brand-logo"
        />
      </a>

      <button
        type="button"
        class="search-pill"
        onclick="document.dispatchEvent(new CustomEvent('amado:openCatalogSearch'))"
        aria-label="Buscar en el catálogo"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="m11 11 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span class="search-pill-label">Buscar</span>
      </button>

      <CartIcon />
    </div>
  )}
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-right: auto;
    transition: opacity 0.15s;
  }

  .brand:hover { opacity: 0.8; }

  .brand-logo {
    display: block;
    width: auto;
    height: 44px;
    flex-shrink: 0;
  }

  .search-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.4rem 0.75rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .search-pill:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.28);
    color: #fff;
  }

  .search-pill-label { display: none; }

  /* Home V2: una cabecera editorial, no una barra de utilidades agrandada. */
  .site-header-home {
    background: rgba(255, 252, 247, 0.96);
    color: #1c1916;
    border-bottom: 0;
  }

  .editorial-header-inner {
    max-width: 1380px;
    height: 68px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .editorial-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.62rem;
    flex: 0 0 auto;
    color: #1c1916;
  }

  .editorial-logo {
    width: auto;
    height: 45px;
  }

  .editorial-brand-copy {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    line-height: 1;
  }

  .editorial-brand-copy strong {
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.09em;
  }

  .editorial-brand-copy small {
    color: #6a625b;
    font-size: 0.59rem;
    font-weight: 650;
    letter-spacing: 0.025em;
  }

  .editorial-nav {
    display: none;
    align-items: center;
    justify-content: center;
    gap: clamp(0.45rem, 1.2vw, 1.35rem);
    flex: 1 1 auto;
  }

  .editorial-nav a {
    position: relative;
    padding: 0.55rem 0.1rem;
    color: #2b2622;
    font-family: var(--font-display);
    font-size: clamp(0.93rem, 1.35vw, 1.13rem);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .editorial-nav a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.28rem;
    left: 0;
    height: 2px;
    background: #ff6d43;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.18s ease;
  }

  .editorial-nav a:hover::after { transform: scaleX(1); }

  .editorial-nav .editorial-nav-emphasis {
    padding: 0.58rem 0.8rem;
    border-radius: 999px;
    background: #1c1916;
    color: #fffaf4;
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 800;
  }

  .editorial-nav .editorial-nav-emphasis::after { display: none; }
  .editorial-nav .editorial-nav-emphasis:hover { background: #ff6d43; color: #1c1916; }

  .editorial-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex: 0 0 auto;
  }

  .editorial-search {
    width: 42px;
    height: 42px;
    display: inline-grid;
    place-items: center;
    border: 1px solid #d9d0c4;
    border-radius: 999px;
    background: #fffdf9;
    color: #1c1916;
    cursor: pointer;
  }

  .editorial-search:hover { border-color: #1c1916; }

  .editorial-actions :global(.cart-icon-btn) {
    min-width: 42px;
    min-height: 42px;
    color: #1c1916;
    border-color: #d9d0c4;
    background: #fffdf9;
  }

  .editorial-actions :global(.cart-icon-btn:hover) {
    color: #1c1916;
    border-color: #1c1916;
    background: #fff;
  }

  .editorial-menu {
    position: relative;
  }

  .editorial-menu summary {
    width: 42px;
    height: 42px;
    display: grid;
    place-content: center;
    gap: 4px;
    border: 1px solid #d9d0c4;
    border-radius: 999px;
    background: #fffdf9;
    cursor: pointer;
    list-style: none;
  }

  .editorial-menu summary::-webkit-details-marker { display: none; }

  .editorial-menu summary span {
    width: 17px;
    height: 1.5px;
    background: #1c1916;
  }

  .editorial-menu-panel {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    width: min(82vw, 280px);
    padding: 0.65rem;
    display: grid;
    gap: 0.15rem;
    border: 1px solid #d9d0c4;
    border-radius: 0.85rem;
    background: #fffdf9;
    box-shadow: 0 18px 50px rgba(27, 23, 19, 0.18);
  }

  .editorial-menu-panel a {
    padding: 0.75rem 0.8rem;
    border-radius: 0.55rem;
    color: #1c1916;
    font-size: 0.88rem;
    font-weight: 750;
  }

  .editorial-menu-panel a:hover { background: #f3eade; }

  .subject-strip {
    overflow-x: auto;
    background: #1c1916;
    color: #fffaf4;
    scrollbar-width: none;
  }

  .subject-strip::-webkit-scrollbar { display: none; }

  .subject-strip-inner {
    width: max-content;
    min-width: 100%;
    height: 39px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .subject-strip a {
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding: 0 0.85rem;
    border-right: 1px solid rgba(255, 255, 255, 0.13);
    color: rgba(255, 250, 244, 0.84);
    font-size: 0.7rem;
    font-weight: 750;
    white-space: nowrap;
  }

  .subject-strip a:first-child { border-left: 1px solid rgba(255, 255, 255, 0.13); }
  .subject-strip a:hover { background: #ff6d43; color: #1c1916; }

  @media (min-width: 400px) {
    .search-pill-label { display: inline; }
  }

  @media (max-width: 520px) {
    .editorial-brand-copy small { display: none; }
    .editorial-brand-copy strong { font-size: 0.68rem; }
    .editorial-logo { height: 40px; }
    .editorial-header-inner { height: 62px; padding: 0 0.75rem; gap: 0.55rem; }
    .editorial-search,
    .editorial-menu summary { width: 39px; height: 39px; }
    .editorial-actions :global(.cart-icon-btn) { min-width: 39px; min-height: 39px; }
    .subject-strip-inner { justify-content: flex-start; }
  }

  @media (min-width: 768px) {
    .header-inner { padding: 0 1.5rem; }
    .brand-logo { height: 48px; }
    .editorial-header-inner { padding: 0 1.5rem; }
  }

  @media (min-width: 980px) {
    .editorial-nav { display: flex; }
    .editorial-menu { display: none; }
    .editorial-header-inner { height: 76px; }
    .editorial-logo { height: 50px; }
  }

  @media (min-width: 1280px) {
    .editorial-header-inner { padding: 0 2rem; }
  }
</style>
