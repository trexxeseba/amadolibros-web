---
import CartIcon from './CartIcon.astro';
import AnnouncementBar from './AnnouncementBar.astro';

interface Props {
  showSearch?: boolean;
  current?: 'libros' | 'temas' | 'pedir' | 'nosotros' | '';
}

const {
  showSearch = true,
  current = '',
} = Astro.props;

// Mismos accesos y mismo aspecto que el encabezado de las páginas SSR
// (functions/_shared/site-header.js): crema, marca en tipografía editorial y
// terracota. Así carrito, pedido y pedir un libro se ven como la misma tienda
// que la portada, el catálogo y las fichas.
const nav = [
  { id: 'libros', label: 'Libros', href: '/catalogo' },
  { id: 'temas', label: 'Temas', href: '/temas' },
  { id: 'pedir', label: 'Pedir un libro', href: '/pedir-libro/?tipo=exacto', highlight: true },
  { id: 'nosotros', label: 'Nosotros', href: '/quienes-somos/' },
];
---
<header class="site-header">
  <AnnouncementBar />
  <div class:list={['header-inner', { 'without-search': !showSearch }]}>

    <a href="/" class="brand" aria-label="Amado Libros — inicio">
      <img
        src="/images/logo-amado.webp"
        alt="Amado Libros"
        width="58"
        height="57"
        class="brand-logo"
      />
      <span class="brand-copy">
        <strong>Amado Libros</strong>
        <small>Librería en línea · Uruguay</small>
      </span>
    </a>

    {showSearch && (
      <button
        type="button"
        class="search-pill"
        onclick="document.dispatchEvent(new CustomEvent('amado:openCatalogSearch'))"
        aria-label="Buscar en el catálogo"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="m11 11 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span class="search-pill-label">Buscar</span>
      </button>
    )}

    <CartIcon />

  </div>
  <nav class="site-nav" aria-label="Navegación principal">
    {nav.map(item => (
      <a
        class:list={['site-nav-link', { 'is-highlight': item.highlight }]}
        href={item.href}
        aria-current={item.id === current ? 'page' : undefined}
      >{item.label}</a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 252, 246, 0.97);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid #e6dccf;
    color: #1b1714;
  }

  .header-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0.55rem 1rem 0.3rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
    margin-right: auto;
    color: #1b1714;
    text-decoration: none;
  }

  .brand-logo {
    display: block;
    width: auto;
    height: 40px;
    flex-shrink: 0;
  }

  .brand-copy { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-copy strong {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
  }
  .brand-copy small {
    display: none;
    margin-top: 0.2rem;
    color: #6b625b;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .search-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.4rem 0.85rem;
    background: #fff;
    border: 1px solid #d7cec2;
    border-radius: 999px;
    color: #1b1714;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }
  .search-pill:hover { border-color: #b4442a; color: #b4442a; }

  .search-pill-label { display: none; }
  @media (min-width: 400px) { .search-pill-label { display: inline; } }

  .site-header :global(.cart-icon-btn) {
    color: #1b1714;
    background: #fff;
    border-color: #d7cec2;
  }
  .site-header :global(.cart-icon-btn:hover) {
    color: #b4442a;
    background: #fff;
    border-color: #b4442a;
  }

  .site-nav {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1rem 0.5rem;
    display: flex;
    gap: 0.35rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .site-nav::-webkit-scrollbar { display: none; }

  .site-nav-link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.35rem 0.8rem;
    border: 1px solid #e0d6c9;
    border-radius: 999px;
    background: #fff;
    color: #332d28;
    font-family: var(--font-ui);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }
  .site-nav-link:hover { background: #f0e8dc; color: #b4442a; }
  .site-nav-link[aria-current='page'] { background: #1b1714; border-color: #1b1714; color: #fff8f0; }
  .site-nav-link.is-highlight { color: #b4442a; }

  @media (min-width: 768px) {
    .header-inner { padding: 0.6rem 1.5rem 0.35rem; }
    .brand-logo { height: 48px; }
    .brand-copy strong { font-size: 1.25rem; }
    .brand-copy small { display: block; }
    .site-nav { padding: 0 1.5rem 0.5rem; }
    .site-nav-link { border-color: transparent; background: transparent; }
  }
</style>
