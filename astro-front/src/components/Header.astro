---
import CartIcon from './CartIcon.astro';

interface Props {
  showSearch?: boolean;
  showMobileDeliveryBanner?: boolean;
}

const {
  showSearch = true,
  showMobileDeliveryBanner = false,
} = Astro.props;

const WA_HREF =
  'https://wa.me/59899841325?text=Hola%20Amado%20Libros%2C%20quer%C3%ADa%20consultar';
const DELIVERY_WA_HREF =
  'https://wa.me/59899841325?text=Hola%20Amado%20Libros%2C%20quiero%20coordinar%20una%20entrega%20en%202%20horas%20en%20Montevideo';
---
<header class="site-header">
  <div class:list={['header-inner', { 'without-search': !showSearch }]}>

    <!-- Marca — logo (gato+libro), sin duplicar el texto "Amado Libros"
         que ya lleva la imagen. width/height fijos: evita layout shift. -->
    <a href="/" class="brand" aria-label="Amado Libros — inicio">
      <img
        src="/images/logo-amado.webp"
        alt="Amado Libros"
        width="58"
        height="57"
        class="brand-logo"
      />
      <span class="brand-sub">Librería uruguaya</span>
    </a>

    <!-- Buscador — abre overlay de búsqueda -->
    {showSearch && (
      <button
        type="button"
        class="search-pill"
        onclick="document.dispatchEvent(new CustomEvent('amado:openCatalogSearch'))"
        aria-label="Buscar en el catálogo"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="m11 11 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span class="search-pill-label">Buscar</span>
      </button>
    )}

    <!-- Carrito -->
    <CartIcon />

    <!-- WhatsApp -->
    <a
      href={WA_HREF}
      target="_blank"
      rel="noopener noreferrer"
      class="wa-btn"
      aria-label="Consultar por WhatsApp"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.663 1.437 5.17L2.057 22.5l5.373-1.408A9.953 9.953 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
      </svg>
      <span class="wa-btn-label">WhatsApp</span>
    </a>

  </div>

  {showMobileDeliveryBanner && (
    <a
      href={DELIVERY_WA_HREF}
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-delivery-banner"
      aria-label="Coordinar entrega en 2 horas en Montevideo por WhatsApp"
    >
      <span aria-hidden="true">⚡</span>
      <strong>Montevideo: entrega en 2 horas*</strong>
      <span class="mobile-delivery-cta">Coordinar →</span>
    </a>
  )}
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 72px;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 1.25rem;
  }

  .header-inner.without-search {
    grid-template-columns: 1fr auto auto;
  }

  .mobile-delivery-banner {
    display: none;
  }

  /* Marca */
  .brand {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
    transition: opacity 0.15s;
  }
  .brand:hover { opacity: 0.8; }

  .brand-logo {
    display: block;
    height: 57px;
    width: 58px;
    flex-shrink: 0;
  }

  .brand-sub {
    font-size: 0.6875rem;
    color: rgba(255, 255, 255, 0.38);
    font-weight: 400;
    display: none;
  }
  @media (min-width: 560px) { .brand-sub { display: block; } }

  /* Buscador — pill compacta */
  .search-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.875rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .search-pill:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.28);
    color: #fff;
  }

  .search-pill-label { display: none; }
  @media (min-width: 400px) { .search-pill-label { display: inline; } }

  /* WA */
  .wa-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.875rem;
    background: rgba(37, 211, 102, 0.1);
    border: 1px solid rgba(37, 211, 102, 0.3);
    border-radius: 999px;
    color: var(--wa);
    font-size: 0.8125rem;
    font-weight: 600;
    flex-shrink: 0;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s;
  }
  .wa-btn:hover {
    background: rgba(37, 211, 102, 0.18);
    border-color: var(--wa);
  }

  .wa-btn-label { display: none; }
  @media (min-width: 560px) { .wa-btn-label { display: inline; } }

  /* Mobile: fila única marca / buscar / wa */
  @media (max-width: 559px) {
    .header-inner {
      gap: 0.75rem;
    }
    .wa-btn { padding: 0.4rem 0.75rem; }

    .mobile-delivery-banner {
      min-height: 38px;
      padding: 0.45rem 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      background: #e49982;
      color: #18120e;
      border-top: 1px solid rgba(255, 255, 255, 0.16);
      font-size: 0.73rem;
      line-height: 1.2;
      text-align: center;
    }

    .mobile-delivery-banner strong {
      font-weight: 800;
    }

    .mobile-delivery-cta {
      font-weight: 700;
      white-space: nowrap;
    }
  }
</style>
