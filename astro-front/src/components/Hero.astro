---
import CategoryAccess from './CategoryAccess.astro';
---

<section class="hero-shell">
  <div class="hero">
    <div class="hero-content">
      <span class="hero-badge">Librería uruguaya · compra online</span>

      <h1 class="hero-h1">Tarot, Biblias y libros difíciles de conseguir en Uruguay.</h1>

      <p class="hero-lead">
        Buscá por título, autor o ISBN. También conseguimos ediciones agotadas e importadas de Europa y otros mercados.
      </p>

      <form class="hero-search" action="/catalogo" method="get" role="search">
        <label class="sr-only" for="hero-search-input">Buscar por título, autor o ISBN</label>
        <span class="hero-search-icon" aria-hidden="true">
          <svg width="23" height="23" viewBox="0 0 24 24" fill="none">
            <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.8"/>
            <path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </span>
        <input
          id="hero-search-input"
          type="search"
          name="q"
          placeholder="Título, autor o ISBN"
          autocomplete="off"
          enterkeyhint="search"
        >
        <button type="submit">Buscar</button>
      </form>

      <div class="hero-help">
        <span>¿No aparece en el catálogo?</span>
        <a href="/pedir-libro?tipo=exacto">Pedinos una búsqueda manual →</a>
      </div>
    </div>

    <CategoryAccess />
  </div>
</section>

<style>
  .hero-shell {
    background:
      radial-gradient(circle at 12% 18%, rgba(228, 153, 130, 0.16), transparent 34%),
      radial-gradient(circle at 90% 0%, rgba(218, 193, 135, 0.14), transparent 30%),
      var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .hero {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    gap: 1rem;
    padding: 1.6rem 1rem 1.4rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.5rem 0.25rem;
  }

  .hero-badge {
    align-self: flex-start;
    margin-bottom: 0.65rem;
    color: var(--salmon-hover);
    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.085em;
    text-transform: uppercase;
  }

  .hero-h1 {
    max-width: 13ch;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 7vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.038em;
    line-height: 1.01;
  }

  .hero-lead {
    max-width: 51ch;
    margin-top: 0.9rem;
    color: var(--ink-2);
    font-size: clamp(0.94rem, 2vw, 1.07rem);
    line-height: 1.5;
  }

  .hero-search {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    max-width: 650px;
    margin-top: 1.15rem;
    padding: 0.4rem;
    padding-left: 1rem;
    background: var(--surface);
    border: 1.5px solid #d8cfc4;
    border-radius: 0.875rem;
    box-shadow: 0 8px 28px rgba(24, 18, 14, 0.07);
  }

  .hero-search:focus-within {
    border-color: var(--salmon);
    box-shadow: 0 0 0 4px rgba(228, 153, 130, 0.14);
  }

  .hero-search-icon { display: flex; color: var(--ink); }

  .hero-search input {
    min-width: 0;
    width: 100%;
    padding: 0.68rem 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: 500 1rem/1.2 var(--font-ui);
  }

  .hero-search input::placeholder { color: #8a8178; opacity: 1; }

  .hero-search button {
    min-height: 44px;
    padding: 0.7rem 1.35rem;
    border: 0;
    border-radius: 0.65rem;
    background: var(--salmon);
    color: #fff;
    font: 750 0.95rem/1 var(--font-ui);
    cursor: pointer;
  }

  .hero-search button:hover { background: var(--salmon-hover); }

  .hero-help {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.55rem;
    margin-top: 0.75rem;
    color: var(--ink-2);
    font-size: 0.73rem;
  }

  .hero-help a {
    color: var(--ink);
    font-weight: 800;
    text-decoration-color: var(--salmon);
    text-underline-offset: 0.15em;
  }

  @media (min-width: 700px) {
    .hero { padding: 2.2rem 2rem; }
  }

  @media (min-width: 980px) {
    .hero {
      grid-template-columns: minmax(340px, 0.78fr) minmax(550px, 1.22fr);
      gap: 2rem;
      min-height: 590px;
      align-items: center;
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }
  }

  @media (min-width: 1200px) {
    .hero { padding-left: 0; padding-right: 0; }
  }

  @media (max-width: 430px) {
    .hero-search {
      grid-template-columns: auto minmax(0, 1fr);
      padding: 0.55rem 0.75rem;
    }

    .hero-search button {
      grid-column: 1 / -1;
      width: 100%;
    }
  }
</style>
