---
// Hero mobile-first enfocado en dos pasos: buscar en catálogo y, si no está,
// iniciar una búsqueda humana por encargo. Sin imágenes para proteger LCP.
---

<section class="hero-shell">
  <div class="hero">
    <div class="hero-content">
      <p class="hero-kicker">Libros importados · búsqueda personal</p>

      <h1 class="hero-h1">
        Libros difíciles de encontrar.
        <span>Los conseguimos.</span>
      </h1>

      <p class="hero-lead">
        Buscá entre nuestros libros disponibles. Si el que querés no aparece, lo buscamos por encargo, personalmente.
      </p>

      <form class="hero-search" action="/catalogo" method="get" role="search">
        <label class="sr-only" for="hero-search-input">Buscar por título, autor o ISBN</label>
        <span class="hero-search-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.8"/>
            <path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </span>
        <input
          id="hero-search-input"
          type="search"
          name="q"
          placeholder="Título, autor o ISBN"
          autocomplete="off"
          enterkeyhint="search"
        >
        <button type="submit">Buscar</button>
      </form>

      <a class="hero-request" href="/pedir-libro/?tipo=exacto">
        <span class="hero-request-copy">
          <strong>¿No encontraste el libro que buscás?</strong>
          <small>Contanos cuál es. Revisamos personalmente dónde conseguirlo, incluso si está agotado o descatalogado.</small>
        </span>
        <span class="hero-request-action">Contanos qué libro buscás →</span>
      </a>

      <ul class="hero-benefits" aria-label="Beneficios de compra">
        <li>Hasta 12 cuotas con Mercado Pago</li>
        <li>12% menos por transferencia</li>
      </ul>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var form = document.querySelector('.hero-search');
  var input = document.getElementById('hero-search-input');
  if (!form || !input) return;

  function openExpandedSearch() {
    document.dispatchEvent(new CustomEvent('amado:openCatalogSearch', {
      detail: { query: input.value.trim() },
    }));
  }

  input.addEventListener('focus', openExpandedSearch);
  form.addEventListener('submit', function (event) {
    event.preventDefault();
    openExpandedSearch();
  });
})();
</script>

<style>
  .hero-shell {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .hero {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .hero-content {
    width: min(100%, 900px);
    margin: 0 auto;
    padding: 1.7rem 0.25rem 2rem;
  }

  .hero-kicker {
    margin-bottom: 0.65rem;
    color: var(--ink-2);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.055em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .hero-h1 {
    max-width: 16ch;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2.05rem, 8.8vw, 2.35rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.08;
  }

  .hero-h1 span {
    display: block;
    color: inherit;
    font-style: italic;
    font-weight: 400;
  }

  .hero-lead {
    max-width: 58ch;
    margin-top: 0.9rem;
    color: var(--ink-2);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .hero-search {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.55rem;
    width: min(100%, 760px);
    margin-top: 1rem;
    padding: 0.35rem;
    padding-left: 0.85rem;
    background: var(--surface);
    border: 1px solid #d5ccc0;
    border-radius: 0.55rem;
    box-shadow: 0 5px 18px rgba(24, 18, 14, 0.055);
  }

  .hero-search:focus-within {
    border-color: var(--salmon);
    box-shadow: 0 0 0 4px rgba(180, 68, 42, 0.12);
  }

  .hero-search-icon { display: flex; color: var(--ink); }

  .hero-search input {
    min-width: 0;
    width: 100%;
    padding: 0.68rem 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: 500 0.95rem/1.2 var(--font-ui);
  }

  .hero-search input::placeholder { color: #8a8178; opacity: 1; }

  .hero-search button {
    min-height: 44px;
    padding: 0.7rem 1.1rem;
    border: 0;
    border-radius: 0.35rem;
    background: var(--salmon);
    color: #fff;
    font: 750 0.84rem/1 var(--font-ui);
    cursor: pointer;
    white-space: nowrap;
  }

  .hero-search button:hover { background: var(--salmon-hover); }

  .hero-request {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    width: min(100%, 760px);
    margin-top: 0.7rem;
    padding: 0.9rem 1rem;
    border: 1px solid #d9c6ba;
    border-left: 3px solid var(--salmon);
    border-radius: 0.55rem;
    background: rgba(255, 255, 255, 0.55);
    color: var(--ink);
    text-decoration: none;
  }

  .hero-request:hover {
    border-color: var(--salmon);
    background: rgba(255, 255, 255, 0.82);
  }

  .hero-request-copy strong,
  .hero-request-copy small {
    display: block;
  }

  .hero-request-copy strong {
    font-size: 0.84rem;
    line-height: 1.25;
  }

  .hero-request-copy small {
    max-width: 58ch;
    margin-top: 0.18rem;
    color: var(--ink-2);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .hero-request-action {
    color: var(--salmon-hover);
    font-size: 0.74rem;
    font-weight: 850;
    line-height: 1.2;
    text-align: right;
  }

  .hero-benefits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin-top: 0.8rem;
    padding: 0;
    list-style: none;
  }

  .hero-benefits li {
    padding: 0.36rem 0.52rem;
    border: 1px solid var(--border);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.45);
    color: var(--ink-2);
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1.2;
  }

  @media (max-width: 430px) {
    .hero-content {
      padding-top: 1.4rem;
      padding-bottom: 1.55rem;
    }

    .hero-search {
      grid-template-columns: auto minmax(0, 1fr);
      padding: 0.45rem 0.65rem;
    }

    .hero-search button {
      grid-column: 1 / -1;
      width: 100%;
    }

    .hero-request {
      grid-template-columns: 1fr;
      gap: 0.45rem;
      padding: 0.8rem 0.85rem;
    }

    .hero-request-action { text-align: left; }
  }

  @media (min-width: 700px) {
    .hero {
      padding-right: 2rem;
      padding-left: 2rem;
    }

    .hero-content {
      padding-top: 2.65rem;
      padding-bottom: 2.55rem;
    }

    .hero-kicker { font-size: 0.72rem; }

    .hero-h1 {
      max-width: 16ch;
      font-size: clamp(2.7rem, 4.8vw, 3.15rem);
      letter-spacing: -0.015em;
      line-height: 1.04;
    }

    .hero-lead {
      margin-top: 1.05rem;
      font-size: 1rem;
    }

    .hero-search { margin-top: 1.2rem; }
    .hero-search button { padding-right: 1.3rem; padding-left: 1.3rem; font-size: 0.88rem; }

    .hero-request-copy strong { font-size: 0.9rem; }
    .hero-request-copy small { font-size: 0.76rem; }
    .hero-request-action { font-size: 0.78rem; }
  }

  @media (min-width: 1100px) {
    .hero-content {
      width: min(100%, 960px);
      padding-top: 3rem;
      padding-bottom: 2.8rem;
    }

    .hero-h1 {
      max-width: 18ch;
      font-size: 3.15rem;
    }

    .hero-lead { max-width: 62ch; }
  }
</style>