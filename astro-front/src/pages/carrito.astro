    function clearFieldErrors() {
      var errs = document.querySelectorAll('.field-error');
      for (var i = 0; i < errs.length; i++) { errs[i].hidden = true; errs[i].textContent = ''; }
      var invalids = document.querySelectorAll('[aria-invalid="true"]');
