---
import BaseLayout            from '../layouts/BaseLayout.astro';
import Header                from '../components/Header.astro';
import Hero                  from '../components/Hero.astro';
import BestsellerSection     from '../components/BestsellerSection.astro';
import CategoryAccess        from '../components/CategoryAccess.astro';
import OrderHubAccess        from '../components/OrderHubAccess.astro';
import AmadoLee              from '../components/AmadoLee.astro';
import BookDiscovery         from '../components/BookDiscovery.astro';
import CommercialBenefits   from '../components/CommercialBenefits.astro';
import DeliveryCoordination from '../components/DeliveryCoordination.astro';
import HowToBuy              from '../components/HowToBuy.astro';
import TrustStrip            from '../components/TrustStrip.astro';
import Footer                from '../components/Footer.astro';
import SearchOverlay         from '../components/SearchOverlay.astro';
import CatalogSearchOverlay from '../components/CatalogSearchOverlay.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'OnlineStore',
      '@id': 'https://www.amadolibros.com/#bookstore',
      name: 'Amado Libros',
      url: 'https://www.amadolibros.com/',
      logo: 'https://www.amadolibros.com/images/logo-amado.webp',
      image: 'https://www.amadolibros.com/images/logo-amado.webp',
      description: 'Librería online uruguaya de libros importados, disponibles y búsquedas humanas por encargo de ediciones agotadas o difíciles de conseguir.',
      telephone: '+59899841325',
      email: 'adm@amadolibros.com',
      sameAs: [
        'https://www.mercadolibre.com.uy/tienda/amado-libros-libreria-en-linea',
        'https://www.instagram.com/amadolibros.uy/',
      ],
      areaServed: { '@type': 'Country', name: 'Uruguay' },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: '+59899841325',
        email: 'adm@amadolibros.com',
        availableLanguage: 'Spanish',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.amadolibros.com/#website',
      url: 'https://www.amadolibros.com/',
      name: 'Amado Libros',
      publisher: { '@id': 'https://www.amadolibros.com/#bookstore' },
      inLanguage: 'es-UY',
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: 'https://www.amadolibros.com/catalogo?q={search_term_string}',
        },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
---
<BaseLayout
  title="Amado Libros | Libros importados y difíciles de encontrar"
  canonical="https://www.amadolibros.com/"
  description="Buscá libros importados disponibles en Uruguay. Si una edición no aparece, en Amado Libros la buscamos personalmente por encargo."
  jsonLd={jsonLd}
>
  <Header showSearch={false} />
  <main>
    <Hero />
    <BestsellerSection />

    <div id="temas" class="home-topics-shell">
      <CategoryAccess />
    </div>

    <OrderHubAccess />
    <AmadoLee />
    <BookDiscovery />
    <CommercialBenefits />
    <DeliveryCoordination />
    <HowToBuy />
    <TrustStrip />
  </main>
  <Footer />
  <SearchOverlay />
  <CatalogSearchOverlay />
</BaseLayout>

<style>
  .home-topics-shell {
    padding: clamp(3.2rem, 6vw, 6rem) max(1rem, calc((100vw - 1280px) / 2));
    background: #fffaf4;
    scroll-margin-top: 9rem;
  }

  .home-topics-shell :global(.ca-panel) {
    padding-top: 0;
    border-top: 0;
  }

  .home-topics-shell :global(.ca-heading-row h2) {
    max-width: 14ch;
    font-size: clamp(2.7rem, 5.4vw, 4.8rem);
    letter-spacing: -0.045em;
    line-height: 0.96;
  }

  .home-topics-shell :global(.ca-card) {
    border-radius: 0.7rem;
  }
</style>
