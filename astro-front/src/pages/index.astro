---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeV2Header from '../components/HomeV2Header.astro';
import HomeV2Hero from '../components/HomeV2Hero.astro';
import HomeV2Topics from '../components/HomeV2Topics.astro';
import HomeV2Shelf from '../components/HomeV2Shelf.astro';
import HomeV2Ideas from '../components/HomeV2Ideas.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import CatalogSearchOverlay from '../components/CatalogSearchOverlay.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'OnlineStore',
      '@id': 'https://www.amadolibros.com/#bookstore',
      name: 'Amado Libros',
      url: 'https://www.amadolibros.com/',
      logo: 'https://www.amadolibros.com/images/logo-amado.webp',
      image: 'https://www.amadolibros.com/images/logo-amado.webp',
      description: 'Librería online uruguaya especializada en libros importados, agotados, descatalogados y búsquedas por encargo.',
      telephone: '+59899841325',
      email: 'adm@amadolibros.com',
      sameAs: [
        'https://www.mercadolibre.com.uy/tienda/amado-libros-libreria-en-linea',
        'https://www.instagram.com/amadolibros.uy/',
      ],
      areaServed: { '@type': 'Country', name: 'Uruguay' },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: '+59899841325',
        email: 'adm@amadolibros.com',
        availableLanguage: 'Spanish',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.amadolibros.com/#website',
      url: 'https://www.amadolibros.com/',
      name: 'Amado Libros',
      publisher: { '@id': 'https://www.amadolibros.com/#bookstore' },
      inLanguage: 'es-UY',
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: 'https://www.amadolibros.com/catalogo?q={search_term_string}',
        },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
---

<BaseLayout
  title="Libros difíciles de encontrar en Uruguay | Amado Libros"
  canonical="https://www.amadolibros.com/"
  description="Comprá libros importados en Uruguay o pedinos una búsqueda enfocada por encargo para ediciones agotadas, descatalogadas o difíciles de conseguir."
  jsonLd={jsonLd}
>
  <HomeV2Header />
  <main class="home-v2-main">
    <HomeV2Hero />
    <HomeV2Topics />
    <HomeV2Shelf />
    <HomeV2Ideas />
  </main>
  <Footer />
  <SearchOverlay />
  <CatalogSearchOverlay />
</BaseLayout>

<style is:global>
  body {
    padding-bottom: 0 !important;
    background: #fffaf3;
  }

  .home-v2-main { overflow: clip; }

  ::selection {
    background: #ef6844;
    color: #1b1714;
  }
</style>
